rules_version = '2';
// Règles du prototype AGORA : lecture et écriture ouvertes à tous.
// Suffisant pour une démonstration avec des données fictives,
// à ne pas utiliser avec de vraies données personnelles.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
